# Postgres connection string, e.g. postgresql://user:password@localhost:5432/mlb_daily_system
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mlb_daily_system

# Free-tier key from https://the-odds-api.com. The Odds API's free tier
# is 500 requests/month, so this app pulls odds at most TWICE a day (see
# MORNING_ODDS_HOUR_UTC / CLOSING_LINE_HOUR_UTC below and the fetchOdds
# note on runPipeline in lib/pipeline.js). Every hourly sync in between
# only polls the free, unmetered MLB Stats API.
ODDS_API_KEY=

# The pipeline (schedule, pitcher/batter form, lineups, moneyline screen)
# re-runs at the top of every hour, so lineups get picked up within the
# hour they post. The daily research email goes out once, after the run
# at this UTC hour (default 13 = 9 AM ET).
# NEWSLETTER_HOUR_UTC=13
# The one hourly run each day that's also allowed to pull fresh odds (the
# day's opening line). Default 10 UTC = 6 AM ET, well ahead of a typical
# admin review.
# MORNING_ODDS_HOUR_UTC=10
# The one hourly run each day that pulls odds again, for closing-line
# value on published picks. A once-a-day approximation of "near first
# pitch" — games start at different times all day, a twice-a-day odds
# budget can't chase each one. Default 23 UTC = 7 PM ET.
# CLOSING_LINE_HOUR_UTC=23

# --- Admin / content tiers --------------------------------------------
# Structured now, off by default. While false, every signed-in user sees
# every research surface regardless of tier. See lib/tierGate.js.
# PAYWALL_ENABLED=false
# Signs the no-login-required unsubscribe links in admin-composed
# marketing email. Set this to a real stable secret before sending real
# email — without it, a random one is generated at boot and every
# unsubscribe link sent before the next restart stops working. See
# lib/emailCompliance.js.
UNSUBSCRIBE_SECRET=
# A real physical mailing address, required by CAN-SPAM on every
# marketing send. There is no placeholder fallback: the send endpoint
# hard-refuses to fire without this set to something real. See
# lib/emailCompliance.js.
ADMIN_POSTAL_ADDRESS=

# --- Newsletter (optional) ---------------------------------------------
# The daily email (yesterday recap + today's 6 best + all ML + top 15 hits
# + top 10 Ks) goes out after the morning pipeline run. Without these set,
# signups still work — sends are just skipped until you configure it.
# Secret key from https://resend.com (starts with "re_")
RESEND_API_KEY=
# A sender ON A DOMAIN YOU VERIFIED IN RESEND. The value is a full from
# address, not just a domain — pick any local-part on the verified domain.
# e.g. NEWSLETTER_FROM=Slatefinder <picks@daily.slatefinder.com>
NEWSLETTER_FROM=
# Public URL of this app (no trailing slash) — used for unsubscribe links.
# This is the SITE, which can differ from the sending domain above.
APP_BASE_URL=https://slatefinder.lol
# Always email the daily board to this address, whether or not it's on the
# public subscriber list. This is your personal "email it to me" inbox.
OWNER_EMAIL=
