# Postgres connection string, e.g. postgresql://user:password@localhost:5432/mlb_daily_system
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mlb_daily_system

# Free-tier key from https://the-odds-api.com
ODDS_API_KEY=

# Only used by the web dashboard (server.js). Comma-separated list of UTC
# hours to automatically re-run the pipeline each day. Default below is
# ~9am, 4pm, 7pm ET (adjust for your timezone) -- the extra afternoon/
# evening runs exist because MLB lineups aren't posted until 1-3 hours
# before each game, so one morning check alone won't catch them.
# DIGEST_REFRESH_HOURS_UTC=13,20,23

# --- Newsletter (optional) ---------------------------------------------
# The daily email (yesterday recap + today's 6 best + all ML + top 15 hits
# + top 10 Ks) goes out after the morning pipeline run. Without these set,
# signups still work — sends are just skipped until you configure it.
# Secret key from https://resend.com (starts with "re_")
RESEND_API_KEY=
# A sender ON A DOMAIN YOU VERIFIED IN RESEND. The value is a full from
# address, not just a domain — pick any local-part on the verified domain.
# e.g. NEWSLETTER_FROM=Slatefinder <picks@daily.slatefinder.com>
NEWSLETTER_FROM=
# Public URL of this app (no trailing slash) — used for unsubscribe links.
# This is the SITE, which can differ from the sending domain above.
APP_BASE_URL=https://slatefinder.lol
# Always email the daily board to this address, whether or not it's on the
# public subscriber list. This is your personal "email it to me" inbox.
OWNER_EMAIL=
